<?xml version="1.0" encoding="utf-8"?>
<FrameLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <!-- Vulkan render surface -->
    <com.example.g3.EngineView
        android:id="@+id/engineView"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <com.example.g3.SelectionOverlayView
        android:id="@+id/selectionOverlay"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:clickable="false"
        android:focusable="false" />

    <!-- Top-left: commands toggle + drawer -->
    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_margin="16dp"
        android:layout_gravity="top|start"
        android:orientation="vertical">

        <ImageButton
            android:id="@+id/btnCommands"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:layout_marginTop="8dp"
            android:background="@drawable/btn_icon_action_bg"
            android:src="@drawable/ic_btn_commands"
            android:scaleType="centerInside"
            android:padding="9dp"
            android:contentDescription="Команды" />

        <!-- Commands drawer (hidden by default, columnCount set at runtime) -->
        <GridLayout
            android:id="@+id/commandsDrawer"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:columnCount="1"
            android:background="#BB0A0A18"
            android:padding="3dp"
            android:visibility="gone">

            <ImageButton
                android:id="@+id/btnAttack"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:layout_margin="2dp"
                android:background="@drawable/btn_icon_action_bg"
                android:src="@drawable/ic_btn_attack"
                android:scaleType="centerInside"
                android:padding="9dp"
                android:contentDescription="Атаковать" />

            <ImageButton
                android:id="@+id/btnDefend"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:layout_margin="2dp"
                android:background="@drawable/btn_icon_action_bg"
                android:src="@drawable/ic_btn_defend"
                android:scaleType="centerInside"
                android:padding="9dp"
                android:contentDescription="Защищаться" />

            <ImageButton
                android:id="@+id/btnFlyAround"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:layout_margin="2dp"
                android:background="@drawable/btn_icon_action_bg"
                android:src="@drawable/ic_btn_fly"
                android:scaleType="centerInside"
                android:padding="9dp"
                android:contentDescription="Облететь" />

            <ImageButton
                android:id="@+id/btnPatrol"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:layout_margin="2dp"
                android:background="@drawable/btn_icon_action_bg"
                android:src="@drawable/ic_btn_patrol"
                android:scaleType="centerInside"
                android:padding="9dp"
                android:contentDescription="Патруль" />

            <ImageButton
                android:id="@+id/btnHome"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:layout_margin="2dp"
                android:background="@drawable/btn_icon_action_bg"
                android:src="@drawable/ic_btn_home"
                android:scaleType="centerInside"
                android:padding="9dp"
                android:contentDescription="Позиция сбора" />

        </GridLayout>

        <!-- Build button -->
        <ImageButton
            android:id="@+id/btnBuild"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:layout_marginTop="8dp"
            android:background="@drawable/btn_icon_action_bg"
            android:src="@drawable/ic_btn_build"
            android:scaleType="centerInside"
            android:padding="9dp"
            android:contentDescription="Строительство" />

        <!-- Build drawer (hidden by default) -->
        <GridLayout
            android:id="@+id/buildDrawer"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:columnCount="1"
            android:background="#BB0A0A18"
            android:padding="3dp"
            android:visibility="gone">

            <ImageButton
                android:id="@+id/btnBuildFighter"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:layout_margin="2dp"
                android:background="@drawable/btn_icon_action_bg"
                android:src="@drawable/ic_unit_fighter"
                android:scaleType="centerInside"
                android:padding="9dp"
                android:contentDescription="Построить истребитель" />

        </GridLayout>

    </LinearLayout>

    <!-- Top-right: settings button + ship card -->
    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="top|end"
        android:layout_margin="16dp"
        android:orientation="vertical">

        <ImageButton
            android:id="@+id/btnSettings"
            android:layout_width="30dp"
            android:layout_height="30dp"
            android:layout_gravity="end"
            android:background="@drawable/btn_mode_bg"
            android:src="@android:drawable/ic_menu_manage"
            android:scaleType="centerInside"
            android:padding="6dp"
            android:contentDescription="Настройки" />

    <LinearLayout
        android:id="@+id/shipCard"
        android:layout_width="220dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:background="@drawable/ship_card_bg"
        android:orientation="horizontal"
        android:visibility="gone">

        <ImageView
            android:id="@+id/shipCardIcon"
            android:layout_width="58dp"
            android:layout_height="58dp"
            android:src="@drawable/ic_fighter_card"
            android:contentDescription="Selected fighter" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="10dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/shipCardTitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Fighter"
                android:textColor="#FFFFFF"
                android:textSize="15sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/shipCardSubtitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="3dp"
                android:text="Ready"
                android:textColor="#CFE8FF"
                android:textSize="12sp" />

            <TextView
                android:id="@+id/shipCardHint"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="5dp"
                android:text="Select target"
                android:textColor="#93FFB8"
                android:textSize="12sp" />

        </LinearLayout>
    </LinearLayout>
    </LinearLayout>

    <com.example.g3.CameraJoystickView
        android:id="@+id/cameraJoystick"
        android:layout_width="168dp"
        android:layout_height="168dp"
        android:layout_gravity="bottom|end"
        android:layout_marginEnd="16dp"
        android:layout_marginBottom="16dp"
        android:clickable="true"
        android:focusable="true"
        android:contentDescription="Camera joystick" />

    <!-- Microphone button — one-shot listen session -->
    <ImageButton
        android:id="@+id/btnMic"
        android:layout_width="34dp"
        android:layout_height="34dp"
        android:layout_gravity="bottom|center_horizontal"
        android:layout_marginBottom="20dp"
        android:background="@drawable/btn_icon_action_bg"
        android:src="@android:drawable/ic_btn_speak_now"
        android:scaleType="centerInside"
        android:padding="7dp"
        android:contentDescription="Голосовая команда" />

    <!-- Pull tab above axis indicator — swipe down to reveal settings button -->
    <LinearLayout
        android:id="@+id/axisPanel"
        android:layout_gravity="top|end"
        android:layout_marginTop="8dp"
        android:layout_marginEnd="16dp"
        android:orientation="vertical"
        android:layout_width="36dp"
        android:layout_height="wrap_content">

        <TextView
            android:id="@+id/settingsPullTab"
            android:layout_width="36dp"
            android:layout_height="20dp"
            android:gravity="center"
            android:text="∨"
            android:textColor="#AAEEDDCC"
            android:textSize="14sp"
            android:background="#44000000" />

        <com.example.g3.AxisIndicatorView
            android:id="@+id/axisIndicator"
            android:layout_width="36dp"
            android:layout_height="36dp" />

    </LinearLayout>

    <!-- Status text (errors) -->
    <TextView
        android:id="@+id/statusText"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|start"
        android:layout_marginStart="16dp"
        android:layout_marginBottom="16dp"
        android:padding="8dp"
        android:background="#88000000"
        android:textColor="#FFFFFF"
        android:textSize="12sp"
        android:visibility="gone" />

</FrameLayout>
