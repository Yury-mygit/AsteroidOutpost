<?xml version="1.0" encoding="utf-8"?>
<!--
  Outpost root layout. The Vulkan engine surface is the only persistent
  child; the HUD, ability bar, overlays and FPS readout are added
  programmatically in `MainActivity.onCreate`. `statusText` is reserved
  for asset-load error messages (kept hidden until something fails).
-->
<FrameLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <com.example.asteroidoutpost.EngineView
        android:id="@+id/engineView"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <TextView
        android:id="@+id/statusText"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|start"
        android:layout_marginStart="16dp"
        android:layout_marginBottom="16dp"
        android:padding="8dp"
        android:background="#88000000"
        android:textColor="#FFFFFF"
        android:textSize="12sp"
        android:visibility="gone" />

</FrameLayout>
