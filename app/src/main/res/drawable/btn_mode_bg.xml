<?xml version="1.0" encoding="utf-8"?>
<!-- Selector: active (rotate mode) = accent blue, inactive = dark semi-transparent -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_activated="true">
        <shape android:shape="oval">
            <solid android:color="#CC1565C0" />
            <stroke android:width="2dp" android:color="#4FC3F7" />
        </shape>
    </item>
    <item>
        <shape android:shape="oval">
            <solid android:color="#AA1A1A2E" />
            <stroke android:width="1dp" android:color="#4DFFFFFF" />
        </shape>
    </item>
</selector>